<?xml version="1.0" encoding="utf-8"?>
<!-- YugiPC window background for every screen: brand dark + bloom (never plain black or white) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><color android:color="@color/yugipc_bg"/></item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:gradientRadius="70%p"
                android:centerX="0.5" android:centerY="0.45"
                android:startColor="#2E3F7AE0" android:centerColor="#123F5AB0" android:endColor="#000B0E14"/>
        </shape>
    </item>
</layer-list>
